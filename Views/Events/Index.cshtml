@model List<JsonElement><h2>Race events</h2><div class="row">@foreach(var e in Model){<div class="col-md-4 mb-3"><div class="card p-3"><h5>@e.GetProperty("eventName").GetString()</h5><p>@e.GetProperty("eventDate").ToString()</p><p>@e.GetProperty("location").GetString()</p><a class="btn btn-primary" asp-action="Details" asp-route-id="@e.GetProperty("eventID").GetInt32()">View details</a>@if(Context.Session.GetString("Role")=="Organiser"){<a class="btn btn-outline-secondary mt-2" asp-action="Edit" asp-route-id="@e.GetProperty("eventID").GetInt32()">Edit</a><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@e.GetProperty("eventID").GetInt32()"/><button class="btn btn-outline-danger mt-2">Delete</button></form>}</div></div>}</div>