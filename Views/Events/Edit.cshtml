@model EventVm<h2>Edit event</h2><form method="post"><input asp-for="EventID" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><label asp-for="EventName"></label><input asp-for="EventName" class="form-control mb-2"/><label asp-for="EventDate"></label><input asp-for="EventDate" type="date" class="form-control mb-2"/><label asp-for="StartTime"></label><input asp-for="StartTime" type="time" class="form-control mb-2"/><label asp-for="EndTime"></label><input asp-for="EndTime" type="time" class="form-control mb-2"/><label asp-for="Venue"></label><input asp-for="Venue" class="form-control mb-2"/><label asp-for="Location"></label><input asp-for="Location" class="form-control mb-2"/><label asp-for="Description"></label><textarea asp-for="Description" class="form-control mb-2"></textarea><label asp-for="MaxParticipants"></label><input asp-for="MaxParticipants" class="form-control mb-2"/><label asp-for="Status"></label><select asp-for="Status" class="form-select mb-2"><option>Open</option><option>Closed</option></select><button class="btn btn-primary">Update</button></form>