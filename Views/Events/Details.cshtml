@model JsonElement<h2>@Model.GetProperty("eventName").GetString()</h2><p>@Model.GetProperty("description").ToString()</p><p>@Model.GetProperty("eventDate").ToString() · @Model.GetProperty("venue").GetString()</p><h4>Categories</h4><ul>@foreach(var c in (List<JsonElement>)ViewBag.Categories){<li>@c.GetProperty("categoryName").GetString() - @c.GetProperty("ageGroup").GetString()</li>}</ul>@if(Context.Session.GetString("Role")=="Organiser"){<a class="btn btn-primary" asp-action="Category" asp-route-id="@Model.GetProperty("eventID").GetInt32()">Add category</a>}@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enrol" method="post"><input type="hidden" name="EventID" value="@Model.GetProperty("eventID").GetInt32()"/><select class="form-select my-2" name="CategoryID">@foreach(var c in (List<JsonElement>)ViewBag.Categories){<option value="@c.GetProperty("categoryID").GetInt32()">@c.GetProperty("categoryName").GetString()</option>}</select><button class="btn btn-success">Enrol</button></form>}