@model RegisterVm<h2>Register</h2><form method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="FullName"></label><input asp-for="FullName" class="form-control mb-2"/><label asp-for="Email"></label><input asp-for="Email" class="form-control mb-2"/><label asp-for="Password"></label><input asp-for="Password" type="password" class="form-control mb-2"/><label asp-for="Phone"></label><input asp-for="Phone" class="form-control mb-2"/><label asp-for="Role"></label><select asp-for="Role" class="form-select mb-2"><option>Participant</option><option>Organiser</option></select><h5>Participant information</h5><input asp-for="DateOfBirth" type="date" class="form-control mb-2"/><input asp-for="Gender" placeholder="Gender" class="form-control mb-2"/><input asp-for="Club" placeholder="Club" class="form-control mb-2"/><input asp-for="EmergencyContact" placeholder="Emergency contact" class="form-control mb-2"/><input asp-for="EmergencyPhone" placeholder="Emergency phone" class="form-control mb-2"/><h5>Organiser information</h5><input asp-for="OrgName" placeholder="Organisation" class="form-control mb-2"/><input asp-for="ContactPerson" placeholder="Contact person" class="form-control mb-2"/><input asp-for="Address" placeholder="Address" class="form-control mb-2"/><button class="btn btn-warning">Register</button></form>