@model List<JsonElement><h2>My Enrolments</h2><table class="table"><tr><th>Enrolment</th><th>Event</th><th>Category</th><th>Status</th></tr>@foreach(var x in Model){<tr><td>@x.GetProperty("enrolmentID")</td><td>@x.GetProperty("eventID")</td><td>@x.GetProperty("categoryID")</td><td><span class="badge @(x.GetProperty("status").GetString()=="Enrolled"?"bg-success":"bg-warning")">@x.GetProperty("status").GetString()</span></td></tr>}</table>