@model List<JsonElement><section class="hero p-5 rounded mb-4"><h1>Run your race. Own your day.</h1><p>Find events, enrol and track your results.</p><a class="btn btn-warning" asp-controller="Events" asp-action="Index">Explore events</a></section><h2>Upcoming events</h2><div class="row">@foreach(var e in Model){<div class="col-md-4 mb-3"><div class="card p-3"><h5>@e.GetProperty("eventName").GetString()</h5><p>@e.GetProperty("location").GetString()</p><a asp-controller="Events" asp-action="Details" asp-route-id="@e.GetProperty("eventID").GetInt32()" class="btn btn-primary">Details</a></div></div>}</div>