<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><div class="navbar-nav me-auto"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>@if(Context.Session.GetString("Role")=="Organiser"){<a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a><a class="nav-link" asp-controller="Events" asp-action="Create">Create event</a>}@if(Context.Session.GetString("Role")=="Participant"){<a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My enrolments</a><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>}</div>@if(Context.Session.GetInt32("UserID")!=null){<a class="btn btn-outline-light" asp-controller="Account" asp-action="Logout">Logout</a>}else{<a class="btn btn-outline-light me-2" asp-controller="Account" asp-action="Login">Login</a><a class="btn btn-warning" asp-controller="Account" asp-action="Register">Register</a>}</div></nav><main class="container py-4">@if(TempData["Message"]!=null){<div class="alert alert-info">@TempData["Message"]</div>}@RenderBody()</main><footer class="text-center py-4 text-muted">© 2026 RaceDay</footer></body></html>